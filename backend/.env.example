QP_ONLINE_MODEL=qwen2.5-coder:7b
QP_OFFLINE_MODEL=gemma4
QP_MODEL_MODE=auto
QP_CONNECTIVITY_TIMEOUT_S=1.5
# Use the exact browser origin(s), without a trailing slash.
QP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://querypilot-1-25qp.onrender.com
# Alternatively set one frontend origin with QP_FRONTEND_URL.
# QP_FRONTEND_URL=https://querypilot-1-25qp.onrender.com
QP_MAX_REPAIRS=1
OLLAMA_URL=http://127.0.0.1:11434

# LLM provider: auto uses Grok when XAI_API_KEY is present, otherwise Ollama.
# Set QP_LLM_PROVIDER=grok to require Grok in deployment.
QP_LLM_PROVIDER=auto
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.7
XAI_TIMEOUT_S=120
